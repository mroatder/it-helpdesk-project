# Backend Environment Variables — Example File
# ──────────────────────────────────────────────────────────────
# คัดลอกไฟล์นี้แล้วเปลี่ยนชื่อเป็น `.env`
# จากนั้นกรอกค่าจริงของคุณลงไป
# ห้าม commit ไฟล์ .env จริงลง Git เด็ดขาด!
# ──────────────────────────────────────────────────────────────

# ── Server Port ──────────────────────────────────────────────
PORT=3001

# ── Database (MSSQL) ─────────────────────────────────────────
DB_SERVER=YOUR_SERVER_NAME\SQLEXPRESS
DB_NAME=IT_Helpdesk
DB_USER=sa
DB_PASSWORD=YOUR_DB_PASSWORD
DB_PORT=1433
DB_ENCRYPT=false

# ── Frontend URL & CORS ───────────────────────────────────────
APP_FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Active Directory (LDAP) ───────────────────────────────────
# ใช้สำหรับ Login ด้วยบัญชี Windows (Domain) ของบริษัท
AD_URL=ldap://YOUR_AD_SERVER_IP
AD_BASE_DN=DC=YOUR_DOMAIN
AD_DOMAIN=YOUR_DOMAIN

# บัญชีที่ใช้อ่านข้อมูลจาก AD (ต้องมีสิทธิ์ read-only)
AD_ADMIN_USER=YOUR_DOMAIN\administrator
AD_ADMIN_PASSWORD=YOUR_AD_ADMIN_PASSWORD

# ── JWT (JSON Web Token) Secret Key ──────────────────────────
# สร้างค่าใหม่ได้ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=YOUR_STRONG_RANDOM_SECRET_KEY_HERE

# ── Report API Key (Power BI / External Tools) ────────────────
# ใช้สำหรับดึงข้อมูล Report จาก External Systems เช่น Power BI
# สร้างค่าใหม่ได้ด้วยคำสั่ง: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REPORT_API_KEY=YOUR_REPORT_API_KEY_HERE
